{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mousebench",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "mousebench.fyi",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public"
  }
}